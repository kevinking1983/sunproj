# Copy to supabase/functions/.env for `npm run functions:serve`. Defaults target the
# open-source test stack (infra/opensource). For production set real values with
# `supabase secrets set` instead; never set RAZORPAY_BASE_URL or PUSH_PROVIDER=ntfy there.

# Razorpay (mock gateway)
RAZORPAY_BASE_URL=http://host.docker.internal:4010/v1
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=mock_key_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret

# OTP (MSG91 mock; local auth uses fixed test OTPs anyway)
MSG91_AUTH_KEY=mock
MSG91_OTP_TEMPLATE_ID=mock
SEND_SMS_HOOK_SECRET=v1,whsec_bW9ja19zZW5kX3Ntc19ob29rX3NlY3JldA==

# Push
PUSH_PROVIDER=ntfy
NTFY_URL=http://host.docker.internal:4020

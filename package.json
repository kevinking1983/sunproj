{
  "name": "ration",
  "private": true,
  "version": "0.1.0",
  "description": "RATION quick-commerce platform: mobile app, website, admin and Supabase backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @ration/mobile",
    "mobile:android": "npm run android -w @ration/mobile",
    "mobile:ios": "npm run ios -w @ration/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env --no-verify-jwt",
    "oss:up": "docker compose -f infra/opensource/docker-compose.yml up -d --build",
    "oss:down": "docker compose -f infra/opensource/docker-compose.yml down",
    "oss:gateway": "node infra/opensource/mock-gateway/server.mjs",
    "web": "npm run dev -w @ration/web",
    "web:build": "npm run build -w @ration/web",
    "admin": "npm run dev -w @ration/admin",
    "admin:build": "npm run build -w @ration/admin",
    "oss:rider": "node infra/opensource/simulate-rider.mjs",
    "rider": "npm run start -w @ration/rider",
    "oss:start": "node scripts/oss-start.mjs",
    "oss:check": "node scripts/oss-check.mjs",
    "oss:stop": "node scripts/oss-stop.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supabase": "^2.121.0"
  }
}

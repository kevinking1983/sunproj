{
  "name": "ration",
  "private": true,
  "version": "0.1.0",
  "description": "RATION quick-commerce platform: mobile app, website, admin and Supabase backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @ration/mobile",
    "mobile:android": "npm run android -w @ration/mobile",
    "mobile:ios": "npm run ios -w @ration/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supabase": "^2.121.0"
  }
}

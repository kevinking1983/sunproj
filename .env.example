# Copy to apps/mobile/.env and fill in. Only EXPO_PUBLIC_* values are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
EXPO_PUBLIC_OLA_MAPS_API_KEY=your-ola-maps-key

# Server-side secrets live in Supabase Edge Function secrets, never in the app:
# RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, MSG91_AUTH_KEY, MSG91_TEMPLATE_ID
